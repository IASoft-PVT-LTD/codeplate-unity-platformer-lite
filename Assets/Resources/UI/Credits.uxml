<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Credits. The text comes from Assets/Resources/Content/credits.txt. -->
    <ui:VisualElement name="credits" class="screen dim">
        <ui:VisualElement class="panel">
            <ui:Label class="heading" text="Credits" />
            <ui:ScrollView name="scroll" class="credits-scroll">
                <ui:Label name="credits-text" class="credits-text" text="" />
            </ui:ScrollView>
            <ui:Button name="back" text="Back" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
