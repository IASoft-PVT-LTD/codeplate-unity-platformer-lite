<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- The results panel after the goal. ResultsPanel.cs fills it. -->
    <ui:VisualElement name="results" class="screen dim">
        <ui:VisualElement class="panel">
            <ui:Label name="results-title" class="heading" text="Level clear!" />
            <ui:VisualElement name="results-gems" class="gem-row" />
            <ui:VisualElement class="stat-row"><ui:Label class="stat-name" text="Time" /><ui:Label name="time" class="value" text="" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label class="stat-name" text="Par" /><ui:Label name="par" class="value" text="" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label class="stat-name" text="Best" /><ui:Label name="best" class="value" text="" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label class="stat-name" text="Coins" /><ui:Label name="coins" class="value" text="" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label class="stat-name" text="Deaths" /><ui:Label name="deaths" class="value" text="" /></ui:VisualElement>
            <ui:Label name="new-best" class="new-best" text="New best time!" />
            <ui:VisualElement class="buttons row">
                <ui:Button name="next" text="Next" />
                <ui:Button name="retry" text="Retry" />
                <ui:Button name="map" text="Map" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
