/*
  The game's look: every screen's styles in one file. Sizes are in GAME pixels (the screen is
  480 x 270 of them, scaled up crisply), so 1px here is one pixel of the art.
  Colors are variables: change the palette here (docs/recipes/reskin-and-rebrand.md).
*/
:root {
    --ink: #1a120c;
    --ink-soft: rgba(20, 13, 9, 0.82);
    --panel: #2b1f17;
    --brass: #f2b544;
    --brass-dark: #a8692a;
    --cream: #fbefd5;
    --muted: #c9b48f;
    --teal: #5fd3c4;
    --red: #e86a4f;
    --gem: #9ff3ff;
    --amber: #ffb13b;
    --alarm: #ff4b4b;
    --font-small: 8px;
    --font: 8px;
    --font-big: 16px;
    color: var(--cream);
    font-size: var(--font);
    -unity-font-style: normal;
}

/* ------------------------------------------------------------------ layout */

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.dim {
    background-color: rgba(10, 6, 4, 0.62);
}

.panel {
    background-image: resource("Art/ui/panel");
    -unity-slice-left: 16;
    -unity-slice-right: 16;
    -unity-slice-top: 16;
    -unity-slice-bottom: 16;
    padding: 12px 16px 12px 16px;
    align-items: center;
    min-width: 180px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

/* ------------------------------------------------------------------ text */

Label {
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
    white-space: nowrap;
}

.heading {
    font-size: var(--font-big);
    color: var(--brass);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    text-shadow: 1px 1px 0 var(--ink);
}

.subtle {
    color: var(--muted);
}

.hint {
    color: var(--muted);
    font-size: var(--font-small);
    -unity-text-align: middle-center;
}

.value {
    color: var(--cream);
    -unity-text-align: middle-right;
}

/* ------------------------------------------------------------------ buttons */

Button, .btn {
    background-image: resource("Art/ui/button");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 8;
    -unity-slice-right: 8;
    -unity-slice-top: 8;
    -unity-slice-bottom: 8;
    border-width: 0;
    border-radius: 0;
    color: var(--ink);
    font-size: var(--font);
    -unity-text-align: middle-center;
    min-width: 112px;
    height: 20px;
    margin: 2px 0 2px 0;
    padding: 0 8px 1px 8px;
    -unity-background-image-tint-color: #ffffff;
}

Button:hover, Button:focus {
    background-image: resource("Art/ui/button_focus");
    color: #000000;
}

/*
  Unity's default theme (Theme.tss) styles every button through the .unity-button class, which
  beats the plain Button selector above: a light-grey fill, a grey 1px border and rounded corners.
  Our buttons are sprites, so clear those here with the same class (Game.uss loads after the theme).
*/
.unity-button, .unity-button:hover, .unity-button:active, .unity-button:hover:active,
.unity-button:checked, .unity-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* Keyboard and gamepad focus: a cream outline instead of the default blue. */
Button:focus, .unity-button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-radius: 0;
    border-color: var(--cream);
}

Button:active {
    background-image: resource("Art/ui/button_pressed");
    translate: 0 1px;
}

Button:disabled {
    opacity: 0.45;
}

.btn-small {
    min-width: 0;
    width: 22px;
    height: 20px;
    padding: 0;
}

/* ------------------------------------------------------------------ title */

.title-screen {
    justify-content: flex-start;
    padding-top: 40px;
}

.logo {
    width: 288px;
    height: 72px;
    background-image: resource("Art/ui/logo");
    margin-bottom: 2px;
}

.tagline {
    color: var(--cream);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
    text-shadow: 1px 1px 0 var(--ink);
}

.menu {
    align-items: center;
}

.corner-note {
    position: absolute;
    bottom: 4px;
    right: 6px;
    color: var(--muted);
    font-size: var(--font-small);
    text-shadow: 1px 1px 0 var(--ink);
}

/* ------------------------------------------------------------------ world map */

.map-header {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    align-items: center;
}

.map-title {
    font-size: var(--font-big);
    color: var(--brass);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--ink);
}

.map-subtitle {
    color: var(--cream);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--ink);
}

.map-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-path {
    position: absolute;
    width: 3px;
    height: 3px;
    background-color: var(--brass);
    border-width: 1px;
    border-color: var(--ink);
}

.map-path.locked {
    background-color: #6c5a44;
}

.node {
    position: absolute;
    width: 24px;
    height: 24px;
    min-width: 0;
    margin: 0;
    padding: 0;
    background-image: resource("Art/ui/node_open");
    /* The medallion sprite is the whole button: no fill, no border (see .unity-button above). */
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    color: var(--ink);
    -unity-text-align: middle-center;
    font-size: var(--font);
}

/* Focus/hover grows the medallion instead of drawing a square outline around it. */
.node:hover, .node:focus {
    background-image: resource("Art/ui/node_open");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    scale: 1.2 1.2;
    translate: 0 0;
}

.node.done, .node.done:focus, .node.done:hover {
    background-image: resource("Art/ui/node_done");
}

.node:disabled {
    background-image: resource("Art/ui/node_locked");
    opacity: 1;
}

.node.boss, .node.boss:focus, .node.boss:hover {
    width: 32px;
    height: 32px;
    background-image: resource("Art/ui/boss_node_open");
}

.node.boss.done, .node.boss.done:focus, .node.boss.done:hover {
    background-image: resource("Art/ui/boss_node_done");
}

.node.boss:disabled {
    background-image: resource("Art/ui/boss_node_locked");
}

.node-label {
    position: absolute;
    color: var(--cream);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--ink);
}

.node-gems {
    position: absolute;
    flex-direction: row;
    height: 8px;
}

.node-gem {
    width: 8px;
    height: 8px;
    background-image: resource("Art/ui/gem_empty");
    -unity-background-scale-mode: scale-to-fit;
}

.node-gem.found {
    background-image: resource("Art/ui/gem_full");
}

.map-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 30px;
    align-items: center;
}

.map-level-name {
    color: var(--cream);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--ink);
}

.map-footer {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 6px;
    flex-direction: row;
    align-items: center;
}

.page-btn {
    min-width: 0;
    width: 22px;
}

/* ------------------------------------------------------------------ HUD */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-top {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 5px;
    flex-direction: row;
    align-items: center;
}

.icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.heart {
    background-image: resource("Art/ui/heart_full");
}

.heart.empty {
    background-image: resource("Art/ui/heart_empty");
}

.coin-icon {
    background-image: resource("Art/ui/coin_icon");
    margin-left: 6px;
}

.gem-slot {
    background-image: resource("Art/ui/gem_empty");
}

.gem-slot.found {
    background-image: resource("Art/ui/gem_full");
}

.hud-text {
    color: var(--cream);
    text-shadow: 1px 1px 0 var(--ink);
    margin-left: 2px;
}

/* The level clock: top middle, twice the HUD's text size, on a dark plate so its colour reads over
   every background. Amber from timeWarning, red with a pulse from timeDanger; HudView sets the
   classes and the pulse. A level without a time limit shows the time taken, calm. */
.clock-row {
    position: absolute;
    top: 2px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.clock {
    background-color: rgba(20, 13, 9, 0.80);
    border-width: 1px;
    border-color: var(--muted);
    border-radius: 4px;
    padding: 2px 6px 2px 6px;
    min-width: 52px;
    align-items: center;
}

.clock-text {
    font-size: var(--font-big);
    color: var(--cream);
    text-shadow: 1px 1px 0 var(--ink);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.clock.warn {
    border-color: var(--amber);
}

.clock.warn .clock-text {
    color: var(--amber);
}

.clock.danger {
    border-color: var(--alarm);
    background-color: rgba(48, 6, 14, 0.86);
}

.clock.danger .clock-text {
    color: var(--alarm);
}

/* Gems sit at the top right, after the spacer (the clock has the middle). */
.hud-gems {
    flex-direction: row;
    align-items: center;
}

/* Out of hearts: a short card, then the level starts again from the beginning. */
.out-of-hearts {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 6, 4, 0.55);
    display: none;
}

.out-of-hearts.on {
    display: flex;
}

.out-of-hearts-title {
    font-size: var(--font-big);
    color: var(--alarm);
    text-shadow: 1px 1px 0 var(--ink);
    -unity-text-align: middle-center;
}

.out-of-hearts-small {
    margin-top: 8px;
    color: var(--cream);
    -unity-text-align: middle-center;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 74px;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.banner-small {
    color: var(--brass);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--ink);
}

.banner-big {
    font-size: var(--font-big);
    color: var(--cream);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--ink);
}

.toast {
    position: absolute;
    left: 0;
    right: 0;
    top: 26px;
    color: var(--gem);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--ink);
    transition-property: opacity;
    transition-duration: 0.3s;
}

.boss-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    align-items: center;
}

.boss-name {
    color: var(--red);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--ink);
    margin-bottom: 2px;
}

.boss-pips {
    flex-direction: row;
}

.boss-pip {
    width: 22px;
    height: 6px;
    margin: 0 1px 0 1px;
    background-color: var(--red);
    border-width: 1px;
    border-color: var(--ink);
}

.boss-pip.lost {
    background-color: #4a3428;
}

/* ------------------------------------------------------------------ results, pause, settings */

.stat-row {
    flex-direction: row;
    width: 150px;
    height: 11px;
    margin: 0;
}

.stat-name {
    color: var(--muted);
    flex-grow: 1;
}

.new-best {
    color: var(--teal);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.gem-row {
    flex-direction: row;
    margin: 4px 0 6px 0;
}

.gem-row > .icon {
    margin: 0 2px 0 2px;
}

.buttons {
    margin-top: 6px;
    align-items: center;
}

.buttons.row > Button {
    margin: 0 2px 0 2px;
    min-width: 64px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    width: 250px;
    height: 16px;
    margin: 0;
}

.setting-name {
    width: 100px;
    color: var(--cream);
}

.setting-row Slider {
    flex-grow: 1;
    margin: 0;
}

.setting-row Toggle {
    margin: 0;
}

.setting-row Button {
    min-width: 0;
    flex-grow: 1;
    height: 16px;
    margin: 0;
}

Slider #unity-tracker {
    background-color: #4a3428;
    border-color: var(--ink);
    height: 4px;
    margin-top: -2px;
}

Slider #unity-dragger {
    background-color: var(--brass);
    border-color: var(--ink);
    width: 8px;
    height: 10px;
    margin-top: -5px;
}

Slider:focus #unity-dragger {
    background-color: var(--cream);
}

Toggle #unity-checkmark {
    background-color: #4a3428;
    border-color: var(--ink);
    width: 10px;
    height: 10px;
}

Toggle:checked #unity-checkmark {
    background-color: var(--brass);
}

Toggle:focus #unity-checkmark {
    border-color: var(--cream);
}

.controls-text {
    color: var(--muted);
    white-space: normal;
    width: 250px;
    margin-top: 4px;
    -unity-text-align: upper-left;
}

.credits-text {
    white-space: normal;
    width: 296px;
    -unity-text-align: upper-left;
    color: var(--cream);
}

.credits-scroll {
    height: 150px;
    width: 310px;
}

/* A slim scroll bar in the game's palette, no arrow buttons; the text wraps, so never sideways. */
.credits-scroll .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    margin-left: 4px;
}

.credits-scroll .unity-scroller__low-button,
.credits-scroll .unity-scroller__high-button {
    display: none;
}

.credits-scroll .unity-scroller__slider {
    margin: 0;
    width: 6px;
    min-width: 6px;
}

.credits-scroll .unity-base-slider__tracker {
    background-color: var(--ink);
    border-width: 0;
}

.credits-scroll .unity-base-slider__dragger {
    background-color: var(--muted);
    border-width: 0;
    left: 0;
    width: 6px;
}

/* ------------------------------------------------------------------ touch controls */

.touch {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.touch-btn {
    position: absolute;
    width: 56px;
    height: 56px;
}

.touch-btn.held {
    -unity-background-image-tint-color: #ffe7a8;
    scale: 0.92 0.92;
}

/* Kept to the bottom corners but lifted: TouchControls places the d-pad, dash and jump from
   Game.Core TouchLayout, every bottom edge at least 15% of the screen height up and inside the
   safe area (the numbers below are only the starting look). */
#touch-dash {
    right: 78px;
    bottom: 41px;
    background-image: resource("Art/ui/touch_dash");
}

#touch-jump {
    right: 10px;
    bottom: 47px;
    width: 62px;
    height: 62px;
    background-image: resource("Art/ui/touch_jump");
}

#touch-pause {
    right: 8px;
    top: 26px;
    width: 30px;
    height: 30px;
    background-image: resource("Art/ui/touch_pause");
}

/* The d-pad: one touch surface (#touch-dpad, a bit larger than the art) with the art inside
   (.dpad-art), a 3x3 grid of cells; TouchControls sizes both from TouchLayout (about a quarter of
   the screen width). Each piece only draws: .lit lights an arm or a corner dot while the thumb
   holds it; .unused dims an arm the game has no use for (config.json "dpadAxes"), and the corner
   dots of unused diagonals are hidden. */
.touch-dpad {
    position: absolute;
    left: 10px;
    bottom: 41px;
    width: 72px;
    height: 72px;
}

.dpad-art {
    position: absolute;
    left: 0;
    top: 0;
    width: 72px;
    height: 72px;
}

.dpad-piece {
    position: absolute;
    width: 33.333%;
    height: 33.333%;
}

.dpad-up { left: 33.333%; top: 0; background-image: resource("Art/ui/dpad_up"); }
.dpad-up.lit { background-image: resource("Art/ui/dpad_up_lit"); }
.dpad-left { left: 0; top: 33.333%; background-image: resource("Art/ui/dpad_left"); }
.dpad-left.lit { background-image: resource("Art/ui/dpad_left_lit"); }
.dpad-right { left: 66.667%; top: 33.333%; background-image: resource("Art/ui/dpad_right"); }
.dpad-right.lit { background-image: resource("Art/ui/dpad_right_lit"); }
.dpad-down { left: 33.333%; top: 66.667%; background-image: resource("Art/ui/dpad_down"); }
.dpad-down.lit { background-image: resource("Art/ui/dpad_down_lit"); }
.dpad-hub { left: 33.333%; top: 33.333%; background-image: resource("Art/ui/dpad_hub"); }
.dpad-corner { background-image: resource("Art/ui/dpad_corner"); }
.dpad-corner.lit { background-image: resource("Art/ui/dpad_corner_lit"); }
.dpad-ul { left: 0; top: 0; }
.dpad-ur { left: 66.667%; top: 0; }
.dpad-dl { left: 0; top: 66.667%; }
.dpad-dr { left: 66.667%; top: 66.667%; }

.dpad-arm.unused {
    opacity: 0.3;
}

.dpad-corner.unused {
    display: none;
}

/* ------------------------------------------------------------------ fade */

.fade {
    background-color: #000000;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.fade.on {
    opacity: 1;
}
